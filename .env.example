# Dev database (SQLite). Production target is Postgres.
DATABASE_URL="file:./dev.db"

# Catalog/pricing providers: "mock" (default, offline) or "live".
# "live" requires the API hosts below to be allowlisted in the environment.
CARDSWAP_PROVIDERS="mock"

# Pokémon TCG API (https://pokemontcg.io). Key is optional but raises rate limits.
# POKEMON_TCG_API_BASE="https://api.pokemontcg.io/v2"
# POKEMON_TCG_API_KEY=""

# One Piece source: apitcg.com. Required when CARDSWAP_PROVIDERS=live.
# Get a free key at https://apitcg.com and set it here in your local .env.
ONEPIECE_API_KEY=""
# ONEPIECE_API_BASE="https://apitcg.com/api/one-piece"
