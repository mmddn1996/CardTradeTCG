# Dev database (SQLite). Production target is Postgres.
DATABASE_URL="file:./dev.db"

# Catalog/pricing providers: "mock" (default, offline) or "live".
# "live" requires the API hosts below to be allowlisted in the environment.
CARDSWAP_PROVIDERS="mock"

# --- Identity + art (per game) ---
# Pokémon TCG API (https://pokemontcg.io). Key optional, raises rate limits.
# POKEMON_TCG_API_BASE="https://api.pokemontcg.io/v2"
# POKEMON_TCG_API_KEY=""

# One Piece: apitcg.com. Required when CARDSWAP_PROVIDERS=live.
# Free key at https://apitcg.com.
ONEPIECE_API_KEY=""
# ONEPIECE_API_BASE="https://apitcg.com/api/one-piece"

# --- Pricing (one source, both games) ---
# JustTCG (https://justtcg.com). Required when CARDSWAP_PROVIDERS=live.
JUSTTCG_API_KEY=""
# JUSTTCG_API_BASE="https://api.justtcg.com/v1"
