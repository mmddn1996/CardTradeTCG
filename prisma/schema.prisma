// CardSwap data model — foundation (Stage 1).
// Dev uses SQLite; production target is Postgres (see docs/BUILD_PLAN.md).
// SQLite has no native enums, so controlled vocabularies (condition bands,
// trust tiers, listing types, inventory status) are stored as strings and
// validated via Zod in src/lib/enums.ts. The model is unchanged on Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(cuid())
  displayName          String
  email                String?  @unique
  region               String   @default("AU")
  trustTier               String @default("BASIC") // BASIC | L1 | L2 | L3 | X1
  kycStatus               String @default("NONE")  // NONE | PENDING | VERIFIED
  completedTradeValueCents Int   @default(0)
  ratingAvg               Float?
  createdAt            DateTime @default(now())

  inventory InventoryCard[]
  listings  Listing[]
  offersInitiated Offer[] @relation("OffersInitiated")
  offersReceived  Offer[] @relation("OffersReceived")
}

// Canonical card per game, seeded from set lists. Stable identity is
// (game, set, number, variant, finish). Carries reference image(s).
model CatalogCard {
  id          String  @id @default(cuid())
  game        String  // POKEMON | ONE_PIECE
  set         String
  number      String
  name        String
  variant     String? // e.g. alt-art, promo
  finish      String? // e.g. normal | reverse-holo | foil
  imageUrl    String?
  description String? // rules / ability / effect text from the source
  // Gameplay metadata (varies by game; null where a source doesn't provide it)
  rarity      String?
  cardType    String? // e.g. "Character · Straw Hat Crew" or "Fire · Stage 2 ex"
  cost        String? // One Piece play cost
  power       String? // One Piece power / Pokémon HP
  counter     String? // One Piece counter value
  externalId  String? // id in the source API/provider

  prices    PriceSnapshot[]
  inventory InventoryCard[]
  listings  Listing[]

  @@unique([game, set, number, variant, finish])
  @@index([game, name])
}

// Cached market price for a (card, condition band) tuple, with freshness ts.
model PriceSnapshot {
  id            String   @id @default(cuid())
  catalogCardId String
  conditionBand String   // NM | LP | PL | PO
  valueCents    Int
  source        String   // provider key, e.g. MOCK | POKEMON_TCG_API
  capturedAt    DateTime @default(now())

  catalogCard CatalogCard @relation(fields: [catalogCardId], references: [id], onDelete: Cascade)

  @@unique([catalogCardId, conditionBand, source])
  @@index([catalogCardId])
}

// A digitised physical card owned by a user.
model InventoryCard {
  id            String   @id @default(cuid())
  ownerId       String
  catalogCardId String
  condition     String   @default("NM") // NM | LP | PL | PO
  status        String   @default("VAULT") // VAULT | LISTED | LOCKED
  declaredValueCents Int? // sentimental flag only; cannot exceed market (Spec §3.3)
  photos        String   @default("[]") // JSON array of image refs
  createdAt     DateTime @default(now())

  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  catalogCard CatalogCard @relation(fields: [catalogCardId], references: [id])
  listing     Listing?
  offerItems  OfferItem[]

  @@index([ownerId])
  @@index([catalogCardId])
}

// HAVE = available to trade (backed by an inventory card).
// WANT = wishlist (backed by a catalog card).
model Listing {
  id              String   @id @default(cuid())
  userId          String
  type            String   // HAVE | WANT
  inventoryCardId String?  @unique
  catalogCardId   String?
  notes           String?
  createdAt       DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventoryCard InventoryCard? @relation(fields: [inventoryCardId], references: [id], onDelete: Cascade)
  catalogCard   CatalogCard?   @relation(fields: [catalogCardId], references: [id])

  @@index([userId])
  @@index([type])
}

// A proposed exchange between two users (Spec §5). Each offer carries an
// offered basket (initiator gives) and a requested basket (initiator wants).
// Counter-offers are child offers linked via parentOfferId.
model Offer {
  id            String   @id @default(cuid())
  state         String   @default("PENDING") // OfferState (Spec §5.2)
  initiatorId   String
  responderId   String
  parentOfferId String?
  // Basket totals (AUD cents) snapshotted when sent — the baseline for the
  // volatility re-check at acceptance (Spec §5.5).
  offeredValueCents   Int     @default(0)
  requestedValueCents Int     @default(0)
  message       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  initiator User        @relation("OffersInitiated", fields: [initiatorId], references: [id], onDelete: Cascade)
  responder User        @relation("OffersReceived", fields: [responderId], references: [id], onDelete: Cascade)
  parent    Offer?      @relation("OfferThread", fields: [parentOfferId], references: [id])
  children  Offer[]     @relation("OfferThread")
  items     OfferItem[]
  trade     Trade?

  @@index([initiatorId])
  @@index([responderId])
  @@index([state])
}

// A specific inventory card in one side of an offer's baskets.
model OfferItem {
  id              String @id @default(cuid())
  offerId         String
  side            String // OfferItemSide: OFFERED | REQUESTED
  inventoryCardId String
  valueCents      Int    @default(0) // snapshot when the offer/counter was sent

  offer         Offer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  inventoryCard InventoryCard @relation(fields: [inventoryCardId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@index([inventoryCardId])
}

// Created when an offer is accepted (Spec §5.5). The frozen basket totals are
// the source-of-truth audit record (Spec §3.3). Settlement (Spec §7) is Stage 5.
model Trade {
  id                  String   @id @default(cuid())
  offerId             String   @unique
  status              String   @default("CREATED") // TradeStatus
  offeredValueCents   Int
  requestedValueCents Int
  createdAt           DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id])
}

// Unmatched lookups are queued for catalog gap review (new promos, errors,
// missing sets) rather than rejected (Spec §4.4 / §4.6).
model CatalogGap {
  id           String   @id @default(cuid())
  game         String
  query        String   // the code or search text that found nothing
  kind         String   @default("CODE") // CODE | SEARCH | MANUAL
  status       String   @default("OPEN") // OPEN | RESOLVED
  reportedById String?
  note         String?
  createdAt    DateTime @default(now())

  @@index([status])
}
